# Server Configuration
PORT=5000

# Gemini API Configuration
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
VITE_GEMINI_MODEL=gemini-3.6-flash

# Open-Meteo Weather API Configuration
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast?latitude=13.0827&longitude=80.2707&current=temperature_2m,relative_humidity_2m,wind_speed_10m&hourly=temperature_2m,precipitation_probability,weather_code
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast?latitude=13.0827&longitude=80.2707&current=temperature_2m,relative_humidity_2m,wind_speed_10m&hourly=temperature_2m,precipitation_probability,weather_code
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707
DEFAULT_CITY=Chennai
